  }); } catch (e) {}
  try { bookRows_('PPM', 'Weekly Updates').forEach(function (r) {
    var x = get(r['Letter ID']); if (!x) return; var d = anyIso_(r['Week Ending']) || anyIso_(r['Submitted Date']); if (d > x.weekly) x.weekly = d;
  }); } catch (e) {}
