    if (a.letter) add(70, 'letter', a.first + '\'s performance letter is open', String(a.letter['Performance Period'] || '') + ' · ' + String(a.letter['Status'] || ''), 'a' + a.i);
    if (a.g && a.g.paceApi && a.f.pickedUp < a.g.paceApi) {
