      out[a.id] = { state: String(v.state), summary: String(v.summary || '').slice(0, 160), next: String(v.next || '').slice(0, 120) };
      try { cache.put(a.ck, JSON.stringify(out[a.id]), CLAUDE_READ.TTL); } catch (e) {}
    });
