      status: r.Status || '', created: String(r.CreatedDate || '').slice(0, 10), touched: daysSince_(r.LastModifiedDate), owner: (r.Owner && r.Owner.Name) || '',
      agent: (r.Agent__r && r.Agent__r.Name) || '', what: (r.What && r.What.Name) || '', whatId: r.WhatId || '' });
  };
