  ((v && v.open) || []).filter(function (x) { return x.u === 'now' || x.u === 'today'; }).forEach(function (x) { now.push({ id: 'i:' + x.k, ik: x.k, k: 'inbox', s: x.subject, by: x.from, ask: x.ask }); });
