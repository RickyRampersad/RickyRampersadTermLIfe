    var went = false;
    timedSend_(props, awKey, new Date(), function () { return (went = gameAwardsMail_(day)); });
    if (went) out.push('the week\'s awards');
  }
  return out;
}

/* ─────────── Service ratings: agents and clients rate the work closed for them (20 October 2026) ───────────
