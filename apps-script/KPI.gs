    .map(function (r) { return { id: r.Id, subject: shorten_(r.Subject, 120), status: r.Status || 'Closed', on: String(r.CompletedDateTime || r.LastModifiedDate || '').slice(0, 10), owner: (r.Owner && r.Owner.Name) || '', s: rnNorm_(r.Subject) }; });
