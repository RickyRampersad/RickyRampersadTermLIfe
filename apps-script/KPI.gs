  });
  var since = shiftDays_(day, -QP_DIVE.WINDOW), m30 = shiftDays_(day, -30), m60 = shiftDays_(day, -60);
  var open = q.filter(function (x) { return x.open; });
  var recent = q.filter(function (x) { return x.opened >= since; });
