function gameStreak_(sid, day) {
  var by = {}, any = {};
  try { (hrRows_(ATT, true) || []).forEach(function (r) { var d = isoDay_(r.Date); if (!d) return; any[d] = 1; if (String(r.StaffId) === sid) by[d] = r; }); } catch (e) {}
  var judge = function (d) {
