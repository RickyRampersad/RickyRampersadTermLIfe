      ';border-radius:9px;padding:9px 13px;margin-bottom:7px"><div style="font-size:13px"><b>' + esc_(label[x.a] || x.a) + '</b> · ' + esc_(x.s) + '</div>' +
      (x.r ? '<div style="font-size:12.5px;color:' + MAIL.muted + ';margin-top:2px">' + esc_(x.r) + '</div>' : '') + '</div>';
