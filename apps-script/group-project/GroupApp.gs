/**
 * ============================================================
 *  GROUP APP — the front door of the group project
 *  Ricky Rampersad Branch · group client management, the group bills and the GI renewal desk, in a project of their own
 * ============================================================
 *
 *  Asked for on 26 November 2026: "I would like it to flow fast and service project should not keep this back".
 *
 *  The Service Questionnaire project loads about 2.4 MB of code on every call (the orphan campaign alone is over 1 MB),
 *  so a bare ping took 6 to 8 seconds there, and the group side waited behind the orphan batches for the one script
 *  lock. This project holds the group side alone:
 *
 *    GroupClients.gs, GroupBilling.gs, GIRenewals.gs   copied as they are from apps-script/
 *    GroupShared.gs                                    generated by tools/gas/split-group.js: the sign-in, the support@
 *                                                      mailer and the Salesforce login, copied from the Service
 *                                                      Questionnaire files
 *    GroupApp.gs                                       this file: doGet and doPost, the ping, and the move in
 *
 *  It is a standalone project owned by support@rickyrampersadbranch.com (script.google.com → New project), not bound
 *  to a sheet. It opens the Group Client Management sheet by GCM_SHEET_ID, as it always has, and the Service
 *  Questionnaire sheet (the Agent Skill Bank, for the sign-in) by SQ_SHEET_ID. support@ must be an editor of both.
 *
 *  Script properties it needs, all carried by the move (groupMoveImport) except SQ_SHEET_ID, which is set by hand
 *  first: SQ_SHEET_ID, GCM_SHEET_ID, TEAM_CODE (the branch code), MS_TENANT, MS_CLIENT, MS_SECRET, SF_KEY, SF_SECRET,
 *  SF_LOGIN_URL, ANTHROPIC_API_KEY, and the group's own state (GCM_*, GIR_*).
 *
 *  The move, in this order (apps-script/group-project/README.md has the steps with every click):
 *    OLD project   paste GroupMoveOut.gs, run groupMoveExport, then groupMoveStopOld
 *    NEW project   set SQ_SHEET_ID, run groupMoveImport, Deploy → New deployment → Web app
 *    the site      python3 tools/move/repoint-group.py <the new /exec>, then merge
 *    OLD project   delete GroupClients.gs, GroupBilling.gs, GIRenewals.gs and GroupMoveOut.gs, add GroupKeep.gs,
 *                  Deploy → Manage deployments → New version
 */

var GROUP_APP = {
  VERSION: '2026-11-27a',
  MOVE_TAB: '_move_group',
  /* the small sheet groupMoveExport makes in the account's Drive, found here by its name (or by MOVE_SHEET_ID) */
  MOVE_FILE: 'Group move: settings for the new project (groupMoveImport deletes this)',
  /* the group's own timed jobs, and how each is rebuilt here: the project's own installers, never a copy of them */
  JOBS: ['gcmRefreshTick', 'gcmMondaySend', 'gcmDay1030', 'gcmRehearseTick', 'gcmWelcomeTick'],
  /* the move's own marks never travel */
  SKIP: { GROUP_MOVED_OUT: 1, GROUP_MOVED_IN: 1, MOVE_STOPPED: 1, MOVE_IMPORTED: 1, GROUP_MOVE_FILE: 1, MOVE_SHEET_ID: 1 }
};

/* ── the web app ───────────────────────────────────────────────── */

function doGet(e) {
  var p = (e && e.parameter) || {}, a = String(p.action || '');
  try {
    if (/^gcm\./.test(a)) return groupJson_(gcmDoGet_(p));
    if (a === 'ping' || a === '') return groupJson_(groupPing_());
    return groupJson_({ ok: false, error: 'Unknown action', service: 'Group client management', build: GROUP_APP.VERSION });
  } catch (err) {
    return groupJson_({ ok: false, error: String(err && err.message ? err.message : err).slice(0, 300) });
  }
}

function doPost(e) {
  var body = {};
  try { body = JSON.parse((e && e.postData && e.postData.contents) || '{}'); }
  catch (err) { return groupJson_({ ok: false, error: 'Could not read that submission.' }); }
  try {
    if (/^gcm\./.test(String(body.action || ''))) return groupJson_(gcmDoPost_(body));
    return groupJson_({ ok: false, error: 'Unknown action', service: 'Group client management', build: GROUP_APP.VERSION });
  } catch (err) {
    return groupJson_({ ok: false, error: String(err && err.message ? err.message : err).slice(0, 300) });
  }
}

function groupJson_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

/** ?action=ping: what this project can reach, without signing in. Names and yes/no only, never a value: the address is
 *  public. Nothing in it may throw, or a ping that fails would look like a project that is down. */
function groupPing_() {
  var p = {};
  try { p = PropertiesService.getScriptProperties().getProperties(); } catch (e) {}
  var has = function (k) { return !!String(p[k] || '').trim(); };
  var sheet = function (fn) { try { fn(); return 'ok'; } catch (e) { return 'cannot open'; } };
  var jobs = [];
  try { ScriptApp.getProjectTriggers().forEach(function (t) { jobs.push(t.getHandlerFunction()); }); } catch (e) { jobs = null; }
  var domain = '';
  try { domain = String(Session.getEffectiveUser().getEmail() || '').split('@')[1] || ''; } catch (e) {}
  return {
    ok: true, service: 'Group client management', project: 'group', build: GROUP_APP.VERSION,
    runsAs: domain,
    sheets: {
      sq: has('SQ_SHEET_ID') ? sheet(function () { ss_().getId(); }) : 'not set',
      gcm: has('GCM_SHEET_ID') ? sheet(function () { gcmSS_().getId(); }) : 'not set'
    },
    settings: { teamCode: has('TEAM_CODE'), microsoft: has('MS_TENANT') && has('MS_CLIENT') && has('MS_SECRET'),
                salesforce: has('SF_KEY') && has('SF_SECRET'), ai: has('ANTHROPIC_API_KEY') },
    jobs: jobs,
    timeZone: (function () { try { return Session.getScriptTimeZone() || ''; } catch (e) { return ''; } })(),
    /* the date alone: the ping needs no sign-in, so an account's address never goes in it (27 November 2026: the first
       live ping carried the old owner's address after "from") */
    movedIn: String(p.GROUP_MOVED_IN || '').split(/\s+from\s+/)[0].replace(/\S+@\S+/g, '')
  };
}

/* ── the move in (run here, in the new project) ─────────────────── */

/** Carries the settings and the timed jobs from the Service Questionnaire project. groupMoveExport must have run there
 *  first. The settings are found, in this order: the sheet MOVE_SHEET_ID names; the settings sheet in this account's
 *  Drive, by its name; the hidden _move_group tab of the sheet SQ_SHEET_ID names (the first design). */
function groupMoveImport() {
  var store = PropertiesService.getScriptProperties();
  var found = groupMoveFind_();
  if (found && found.err) return groupSay_(found.err);
  var m = found ? groupMoveRead_(found.sh) : null;
  if (!m) return groupSay_('The settings from the old project were not found. Run groupMoveExport in the old project first. ' +
    'If it did run, add the Script property MOVE_SHEET_ID here, with the ID of the sheet its message names, and run groupMoveImport again.');
  if (m.meta.script && m.meta.script === ScriptApp.getScriptId()) return groupSay_('This is the old project. groupMoveImport runs in the new group project.');

  /* the clock: every timed job runs by the project's time zone, and a new project takes its maker's account zone */
  var here = '';
  try { here = Session.getScriptTimeZone() || ''; } catch (e) {}
  if (m.meta.timeZone && here && here !== m.meta.timeZone) {
    return groupSay_('Stopped before anything was changed: this project runs on the time zone ' + here + ', the old one on ' + m.meta.timeZone + '. ' +
      'The letters, the 10:30 group day and the bills would run at the wrong hour.\n\n' +
      'Fix: Project Settings (the cog) → tick "Show appsscript.json manifest file in editor" → open appsscript.json in the file list → ' +
      'change the "timeZone" line to "' + m.meta.timeZone + '" → Save. Then run groupMoveImport again.');
  }

  /* the settings, all of them: what the group side does not read is harmless, and a setting left behind is a silent fault */
  var keep = { SQ_SHEET_ID: String(store.getProperty('SQ_SHEET_ID') || '').trim() || m.meta.sheet };
  var props = {};
  Object.keys(m.props).forEach(function (k) { if (!GROUP_APP.SKIP[k]) props[k] = m.props[k]; });
  if (m.meta.teamCode) props.TEAM_CODE = m.meta.teamCode;
  Object.keys(keep).forEach(function (k) { if (keep[k]) props[k] = keep[k]; });
  try { store.setProperties(props, false); }
  catch (e) { Object.keys(props).forEach(function (k) { try { store.setProperty(k, props[k]); } catch (e2) {} }); }
  GROUP_SQ_SS_ = null; GCM_SS = null;

  /* the timed jobs that ran there, rebuilt with the project's own installers */
  var made = [], byHand = [];
  m.jobs.forEach(function (fn) {
    try {
      if (fn === 'gcmRefreshTick') {
        ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === fn) ScriptApp.deleteTrigger(t); });
        ScriptApp.newTrigger('gcmRefreshTick').timeBased().everyHours(1).create(); made.push('the hourly refresh');
      } else if (fn === 'gcmMondaySend') { gcmMondayTrigger_(); made.push('the Monday 10:00 letters'); }
      else if (fn === 'gcmDay1030') { gcmDayTrigger_(); made.push('the 10:30 group day'); }
      else byHand.push(fn === 'gcmRehearseTick' ? 'the rehearsal at 10:00 (run gcmRehearseAt10 again if it is still wanted)'
                     : fn === 'gcmWelcomeTick' ? 'the scheduled welcome (run gcmWelcomeAt9 or gcmWelcomeAt6 again if it is still wanted)' : fn);
    } catch (e) { byHand.push(fn + ' (' + String(e && e.message || e).slice(0, 120) + ')'); }
  });
  if (m.jobs.indexOf('gcmRefreshTick') < 0) {
    try { ScriptApp.newTrigger('gcmRefreshTick').timeBased().everyHours(1).create(); made.push('the hourly refresh (it was not running in the old project)'); }
    catch (e) { byHand.push('gcmRefreshTick'); }
  }

  var reach = groupReach_();
  store.setProperty('GROUP_MOVED_IN', new Date().toISOString());
  var gone = groupMoveForget_(found);

  var lines = [];
  lines.push(Object.keys(props).length + ' settings carried across' + (m.meta.teamCode ? ', the branch code among them' : ' (no branch code was set in the old project: add TEAM_CODE by hand)') + '.');
  lines.push('Timed jobs rebuilt here: ' + (made.join(', ') || 'none') + '.');
  if (byHand.length) lines.push('Not rebuilt: ' + byHand.join('; ') + '.');
  lines.push(reach.bad.length ? 'This account cannot open: ' + reach.bad.join('; ') + '. Share each with ' + groupMe_() + ' as an editor, then run groupMoveCheck.'
                              : 'Every sheet and folder the group side names opens (' + reach.ok.join(', ') + ').');
  lines.push(gone);
  lines.push('Next: Deploy → New deployment → Web app, Execute as: Me, Who has access: Anyone. Send the new /exec address to be wired into the group pages.');
  return groupSay_(lines.join('\n\n'));
}

/** Where the old project wrote the settings: { sh, fileId } for the settings sheet, { sh, ss } for the hidden tab. */
function groupMoveFind_() {
  var store = PropertiesService.getScriptProperties();
  var id = String(store.getProperty('MOVE_SHEET_ID') || '').trim();
  var link = /\/d\/([A-Za-z0-9_-]{20,})/.exec(id);
  if (link) id = link[1];
  if (id) {
    try { var f = SpreadsheetApp.openById(id); return { sh: f.getSheetByName(GROUP_APP.MOVE_TAB) || f.getSheets()[0], fileId: id }; }
    catch (e) { return { err: 'The sheet in MOVE_SHEET_ID could not be opened (' + String(e && e.message || e).slice(0, 120) + '): check the ID.' }; }
  }
  try {
    var it = DriveApp.getFilesByName(GROUP_APP.MOVE_FILE), best = null;
    while (it.hasNext()) {
      var x = it.next();
      if (x.isTrashed()) continue;
      if (!best || x.getDateCreated() > best.getDateCreated()) best = x;
    }
    if (best) { var b = SpreadsheetApp.openById(best.getId()); return { sh: b.getSheetByName(GROUP_APP.MOVE_TAB) || b.getSheets()[0], fileId: best.getId() }; }
  } catch (e) {}
  if (String(store.getProperty('SQ_SHEET_ID') || '').trim()) {
    try { var ss = ss_(); return { sh: ss.getSheetByName(GROUP_APP.MOVE_TAB), ss: ss }; }
    catch (e) { return { err: String(e && e.message || e) }; }
  }
  return null;
}

/** The settings held the project's secrets: the sheet is emptied and binned, the tab deleted, MOVE_SHEET_ID removed. */
function groupMoveForget_(found) {
  var store = PropertiesService.getScriptProperties();
  try { store.deleteProperty('MOVE_SHEET_ID'); } catch (e) {}
  if (found && found.fileId) {
    try { SpreadsheetApp.openById(found.fileId).getSheets().forEach(function (sh) { try { sh.clear(); } catch (e) {} }); } catch (e) {}
    try { DriveApp.getFileById(found.fileId).setTrashed(true); return 'The settings sheet, which held the secrets, is emptied and in the bin.'; }
    catch (e) { return 'The settings sheet is emptied, but could not be put in the bin: delete "' + GROUP_APP.MOVE_FILE + '" from your Drive.'; }
  }
  try { if (found && found.ss && found.sh) found.ss.deleteSheet(found.sh); } catch (e) {
    return 'The "' + GROUP_APP.MOVE_TAB + '" tab could not be deleted: delete it from the Service Questionnaire sheet by hand.';
  }
  return 'The "' + GROUP_APP.MOVE_TAB + '" tab, which held the settings, is deleted.';
}

/** After sharing a sheet or folder with this account: which ones it still cannot open. */
function groupMoveCheck() {
  var r = groupReach_();
  return groupSay_(r.bad.length ? 'Still cannot open: ' + r.bad.join('; ') + '.' : 'Every sheet and folder the group side names opens (' + r.ok.join(', ') + ').');
}

function groupReach_() {
  var p = PropertiesService.getScriptProperties().getProperties(), ok = [], bad = [];
  var tryOpen = function (label, fn) { try { fn(); ok.push(label); } catch (e) { bad.push(label); } };
  tryOpen('the Service Questionnaire sheet (SQ_SHEET_ID)', function () { ss_().getId(); });
  tryOpen('the Group Client Management sheet (GCM_SHEET_ID)', function () { gcmSS_().getId(); });
  [['GCM_TRAIN_SHEET_ID', 'the group training sheet'], ['ORPHAN_TRAIN_SHEET_ID', 'the orphan training sheet']].forEach(function (x) {
    if (String(p[x[0]] || '').trim()) tryOpen(x[1] + ' (' + x[0] + ')', function () { SpreadsheetApp.openById(String(p[x[0]]).trim()).getId(); });
  });
  if (String(p.GCM_FORMS_FOLDER || '').trim()) tryOpen('the forms folder (GCM_FORMS_FOLDER)', function () { DriveApp.getFolderById(String(p.GCM_FORMS_FOLDER).trim()).getName(); });
  return { ok: ok, bad: bad };
}

/** The hidden tab the old project wrote: rows of Kind, Key, Value, every value as text behind a "v:". */
function groupMoveRead_(sh) {
  if (!sh || sh.getLastRow() < 2) return null;
  var rows = sh.getRange(1, 1, sh.getLastRow(), 3).getValues(), m = { meta: {}, props: {}, jobs: [] };
  rows.slice(1).forEach(function (r) {
    var kind = String(r[0] || ''), key = String(r[1] || ''), v = String(r[2] || '').replace(/^v:/, '');
    if (kind === 'meta') m.meta[key] = v;
    else if (kind === 'prop' && key) m.props[key] = v;
    else if (kind === 'job' && key) m.jobs.push(key);
  });
  return m.meta.exported ? m : null;
}

function groupMe_() { try { return Session.getEffectiveUser().getEmail() || 'this account'; } catch (e) { return 'this account'; } }

function groupSay_(msg) { console.log(msg); return msg; }
